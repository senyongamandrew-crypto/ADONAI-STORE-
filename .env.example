# ============================================================================
# Adonai Store — Environment Template
# Copy to .env for local development. NEVER commit a real .env file and NEVER
# put real credentials in this template — use placeholders only.
# ============================================================================

# Render Managed PostgreSQL Connection String
# Render automatically injects this into your web service:
DATABASE_URL=postgresql://USER:CHANGE_ME_PASSWORD@HOST:5432/DATABASE

# Web Server & Render Port Binding
PORT=10000

# High-Concurrency Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Store Metadata & Logistics
APP_URL=https://adonai-store.onrender.com
STORE_NAME="Adonai Store"
STORE_ADDRESS="Plot 45 Salama Road / Kibuli, Kampala, Uganda"
STORE_HOTLINE="+256 7656 52403"
STORE_WHATSAPP="+256 7588 73398"
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Security & SSL
FORCE_HTTPS=true

# JWT signing secret for staff/POS session tokens.
# REQUIRED in production. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Session token lifetime in seconds (default: 7 days)
#JWT_TTL_SECONDS=604800

# Emergency Admin & Staff Access — set the REAL values only in the Render
# dashboard (Environment tab), never in source control.
# 1. ADMIN_ACCESS_PIN / ADMIN_KEY -> Full Admin Console & POS Register access
ADMIN_ACCESS_PIN=CHANGE_ME_STRONG_ADMIN_KEY

# 2. STAFF_TERMINAL_KEY / TERMINAL_KEY -> Direct POS Cashier Register access
STAFF_TERMINAL_KEY=CHANGE_ME_STRONG_STAFF_KEY

# Rate limiting (requests per window, per client IP)
#API_RATE_LIMIT=300
#API_RATE_WINDOW=60
#AUTH_RATE_LIMIT=10
#AUTH_RATE_WINDOW=300

# ============================================================================
# Online Payments — Flutterwave (MTN MoMo, Airtel Money, Visa & Mastercard)
# ============================================================================
# Get these from your Flutterwave dashboard:
#   https://dashboard.flutterwave.com → Settings → APIs
# Set the REAL values only in the Render dashboard (Environment tab).
#
# Public key — safe, used by the browser checkout popup:
FLW_PUBLIC_KEY=FLWPUBK-CHANGE_ME
# Secret key — SERVER ONLY. Never commit and never expose to the browser:
FLW_SECRET_KEY=FLWSECK-CHANGE_ME
# Webhook verification hash — any long random string you invent. Paste the
# SAME value in your Flutterwave dashboard → Settings → Webhooks, and set the
# webhook URL to:  https://YOUR-DOMAIN/api/payments/flutterwave/webhook
FLW_SECRET_HASH=CHANGE_ME_LONG_RANDOM_STRING
#
# Charge currency (UGX for a Ugandan store):
#FLW_CURRENCY=UGX
# Minutes an unpaid online order holds stock before auto-release (default 30):
#FLW_PAYMENT_TTL_MINUTES=30
# API base override (leave unset for production):
#FLW_BASE_URL=https://api.flutterwave.com
# DEV ONLY — simulate the gateway locally WITHOUT real keys. Never set on Render.
#FLW_MOCK_MODE=1

# Seed demo staff accounts (weak PINs) on a production database — keep OFF.
#ADONAI_SEED_DEMO_USERS=0
