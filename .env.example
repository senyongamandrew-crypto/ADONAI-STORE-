# Render Managed PostgreSQL Connection String
# Render automatically injects this into your web service:
DATABASE_URL=postgresql://adonai_user:your_secure_password@dpg-xxxxxxxxxx-a.oregon-postgres.render.com/adonai_db

# Web Server & Render Port Binding
PORT=10000

# High-Concurrency Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Store Metadata & Logistics
APP_URL=https://adonaithrift.ug
STORE_NAME="Adonai Thrift Store"
STORE_ADDRESS="Plot 45 Salama Road / Kibuli, Kampala, Uganda"
STORE_HOTLINE="+256 7656 52403"
STORE_WHATSAPP="+256 7588 73398"
GA_MEASUREMENT_ID=G-ADONAI2026

# Security & SSL
FORCE_HTTPS=true

# Emergency Staff Access — the owner's master PIN (4-8 digits).
# Set this in the Render dashboard (Environment tab). Typing it on the
# /login keypad ALWAYS signs you in as admin, verified server-side —
# even if the staff PINs stored in the browser are lost or forgotten.
ADMIN_ACCESS_PIN=246810
