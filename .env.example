# ---------------------------------------------------------------------------
# Adonai Thrift — environment
# Copy to .env.local and fill in. All three Supabase values are required to
# switch the app from the local file driver to Postgres.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key — SERVER ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Scrypt salt for the local driver's password hashes (dev fallback only)
LOCAL_AUTH_SECRET=change-me

# Signing key for the adonai_session cookie, used by BOTH drivers — including
# passkey sign-in under Supabase. Falls back to LOCAL_AUTH_SECRET if unset.
# Set this in production: rotating it signs every staff member out.
SESSION_SECRET=change-me-too

# Leave these unset to run on the local file driver (.data/adonai.json),
# which seeds 24 demo products and ~3 weeks of demo sales automatically.
