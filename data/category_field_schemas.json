{
  "$comment": "Canonical Adonai catalog intake schemas. Edit here, then run `npm run build:schemas` to refresh the browser fallback (js/catalog-schemas.data.js). The server seeds these into the category_field_schemas table and validates every catalog write against them.",
  "version": "2026.10.26",
  "units": {
    "mm": { "label": "Millimetres", "symbol": "mm", "dimension": "length", "per_mm": 1 },
    "cm": { "label": "Centimetres", "symbol": "cm", "dimension": "length", "per_mm": 10 },
    "in": { "label": "Inches", "symbol": "in", "dimension": "length", "per_mm": 25.4 },
    "g": { "label": "Grams", "symbol": "g", "dimension": "weight" },
    "L": { "label": "Litres", "symbol": "L", "dimension": "volume" }
  },
  "global_fields": [
    { "key": "name", "label": "Item title / display name", "column": "name", "group": "Primary identification", "required": true },
    { "key": "sku", "label": "SKU / barcode", "column": "sku", "group": "Primary identification", "required": true },
    { "key": "brand", "label": "Brand label", "column": "brand", "group": "Primary identification", "required": true, "default": "Unbranded", "quick_values": ["Unbranded", "Custom / Handmade"] },
    { "key": "lot_id", "label": "Parent stock lot", "column": "stock_lot_id", "group": "Lot & financial accounting", "required": false },
    { "key": "lot_grade_id", "label": "Tier grade", "column": "lot_grade_id", "group": "Lot & financial accounting", "required": false, "hint": "Required when the lot is tier-graded" },
    { "key": "cogs_unit_cost", "label": "Weighted landed unit COGS", "column": "cost_price", "group": "Lot & financial accounting", "required": false },
    { "key": "suggested_retail_price", "label": "Target retail selling price", "column": "base_price", "group": "Lot & financial accounting", "required": true },
    { "key": "initial_quantity", "label": "Initial stock quantity", "column": "in_stock_count", "group": "Lot & financial accounting", "required": true },
    { "key": "photo_angles", "label": "Category photo angles", "column": "attributes.photo_angles", "group": "Media pipeline", "required": false },
    { "key": "story", "label": "Short product story", "column": "desc", "group": "Storefront & POS copy", "required": false },
    { "key": "search_tags", "label": "Search tags", "column": "search_tags_json", "group": "Storefront & POS copy", "required": false },
    { "key": "fulfillment_notes", "label": "Pickup / delivery notes", "column": "fulfillment_notes", "group": "Storefront & POS copy", "required": false }
  ],
  "option_sets": {
    "jewelry_metals": ["925 Sterling Silver", "18K Gold Plated", "14K Gold Filled", "Solid Gold", "Stainless Steel", "Surgical Steel (316L)", "Titanium", "Brass", "Copper", "Alloy / Mixed Metal"],
    "apparel_materials": ["100% Cotton", "100% Heavyweight Cotton", "Cotton-Polyester Blend", "Polyester", "Linen", "Linen Blend", "Wool", "Wool Blend", "Fleece", "Denim (Cotton)", "Silk", "Viscose / Rayon", "Nylon", "Genuine Leather", "Faux Leather", "Kitenge / Ankara Wax-Print Cotton"],
    "knit_weaves": ["French Terry", "Single Jersey", "Pique", "Rib Knit", "Ripstop", "Denim / Twill", "Poplin", "Oxford", "Flannel", "Fleece", "Chiffon", "Satin", "Crepe"],
    "necklines": ["Crewneck", "V-Neck", "Button Collar", "Spread Collar", "Mandarin Collar", "Polo Collar", "Hooded", "Mock Neck / Turtleneck", "Scoop Neck", "Square Neck", "Off-Shoulder", "Lapel / Notch"],
    "wear_ratings": ["Like new", "Light wear", "Moderate wear", "Heavy wear"]
  },
  "taxonomy": {
    "Outerwear & Jackets": [["Jackets", "tops"], ["Coats", "tops"], ["Blazers", "tops"], ["Hoodies & Fleece", "tops"]],
    "Tops & Shirts": [["T-Shirts", "tops"], ["Shirts & Blouses", "tops"], ["Polo Shirts", "tops"], ["Sweaters & Knitwear", "tops"], ["Hoodies & Sweatshirts", "tops"]],
    "Dresses & Skirts": [["Dresses", "dresses"], ["Jumpsuits & Rompers", "dresses"], ["Skirts", "bottoms"]],
    "Pants & Jeans": [["Jeans", "bottoms"], ["Trousers & Chinos", "bottoms"], ["Shorts", "bottoms"], ["Joggers & Track Pants", "bottoms"]],
    "Shoes": [["Sneakers", "footwear"], ["Formal & Dress Shoes", "footwear"], ["Loafers & Slip-Ons", "footwear"], ["Heels & Pumps", "footwear"], ["Flats", "footwear"]],
    "Boots": [["Ankle Boots", "footwear"], ["Chelsea Boots", "footwear"], ["Work & Combat Boots", "footwear"], ["Knee-High Boots", "footwear"]],
    "Sandals": [["Sandals", "footwear"], ["Slides", "footwear"], ["Flip-Flops", "footwear"]],
    "Activewear & Sportswear": [["Sports Tops & Jackets", "tops"], ["Leggings & Track Pants", "bottoms"]],
    "Suits & Formalwear": [["Suit Jackets & Blazers", "tops"], ["Suit Trousers", "bottoms"], ["Formal Dresses", "dresses"]],
    "Underwear & Sleepwear": [["Sleepwear Tops & Robes", "tops"], ["Sleep & Lounge Pants", "bottoms"], ["Nightdresses", "dresses"]],
    "Bags & Handbags": [["Handbags", "bags"], ["Backpacks", "bags"], ["Tote Bags", "bags"], ["Crossbody & Shoulder Bags", "bags"], ["Clutches & Evening Bags", "bags"], ["Travel & Duffel Bags", "bags"]],
    "Necklaces & Chains": [["Chains", "necklaces"], ["Pendant Necklaces", "necklaces"], ["Chokers", "necklaces"], ["Beaded Necklaces", "necklaces"]],
    "Bracelets & Bangles": [["Bracelets", "rings_bracelets"], ["Bangles", "rings_bracelets"], ["Cuffs", "rings_bracelets"]],
    "Rings & Earrings": [["Stud Earrings", "earrings"], ["Hoop Earrings", "earrings"], ["Dangle Earrings", "earrings"], ["Rings", "rings_bracelets"]],
    "Watches": [["Analog Watches", "watches"], ["Digital Watches", "watches"], ["Smartwatches", "watches"]],
    "Eyewear & Sunglasses": [["Sunglasses", "eyewear"], ["Optical Frames", "eyewear"]],
    "Hats, Scarves & Belts": [["Scarves & Wraps", "scarves"], ["Hats & Caps", "hats"], ["Belts", "belts"]],
    "Traditional & Occasionwear": [["Gomesi / Busuuti", "dresses"], ["Kitenge Dresses & Sets", "dresses"], ["Kanzu", "tops"], ["Kitenge Shirts & Tops", "tops"]],
    "Swimwear & Beachwear": [["Swimsuits & Bikinis", "tops"], ["Swim Shorts", "bottoms"], ["Cover-ups & Kaftans", "dresses"]],
    "Accessories": [["Scarves & Wraps", "scarves"], ["Hats & Caps", "hats"], ["Belts", "belts"], ["Other Accessories", "accessory"]],
    "Children Wear": [["Kids Tops & Outerwear", "tops"], ["Kids Bottoms", "bottoms"], ["Kids Dresses", "dresses"], ["Kids Shoes", "footwear"]]
  },
  "schemas": {
    "earrings": {
      "version": 1,
      "label": "Earrings",
      "group": "Jewelry & Small Accessories",
      "profile": "jewelry",
      "summary": "Earrings intake: millimetre dimensions, pair weight in grams, metal, backing and skin-safety notices. No inches, garment sizes or fabric questions.",
      "core": { "hide": ["size"] },
      "sections": [
        {
          "id": "dimensions", "title": "Dimensions & Units", "note": "Measured strictly in millimetres (mm). Weigh the full pair in grams (g).",
          "fields": [
            { "key": "length", "label": "Length", "type": "measure", "units": ["mm"], "range": [0.5, 150], "step": 0.1 },
            { "key": "width", "label": "Width", "type": "measure", "units": ["mm"], "range": [0.5, 100], "step": 0.1 },
            { "key": "diameter", "label": "Diameter", "type": "measure", "units": ["mm"], "range": [1, 120], "step": 0.1, "when": { "subcategory": ["Stud Earrings", "Hoop Earrings"] } },
            { "key": "stud_depth", "label": "Stud depth (post length)", "type": "measure", "units": ["mm"], "range": [0.5, 30], "step": 0.1, "when": { "subcategory": ["Stud Earrings"] } },
            { "key": "pair_weight", "label": "Total pair weight", "type": "measure", "units": ["g"], "range": [0.05, 200], "step": 0.01 }
          ]
        },
        {
          "id": "material", "title": "Material & Metals",
          "fields": [
            { "key": "primary_metal", "label": "Primary metal / plating", "type": "select", "options_ref": "jewelry_metals", "allow_other": true, "required": true, "tag": true, "projects_to": "fabric" },
            { "key": "accent_material", "label": "Gemstone / accent material", "type": "select", "options": ["None", "Cubic Zirconia", "Glass", "Crystal", "Pearl", "Faux Pearl", "Acrylic", "Enamel", "Natural Gemstone", "Beads"], "allow_other": true, "tag": true, "projects_to": "fabric" }
          ]
        },
        {
          "id": "hardware", "title": "Hardware & Fastenings",
          "fields": [
            { "key": "backing_type", "label": "Backing type", "type": "select", "options": ["Push-Back (Butterfly)", "Screw-Back", "Latch-Back", "Lever-Back", "Fish Hook (French Wire)", "Hinged Snap", "Clip-On"], "required": true, "tag": true }
          ]
        },
        {
          "id": "safety", "title": "Hypoallergenic & Safety Notices",
          "fields": [
            { "key": "nickel_free", "label": "Nickel-free status", "type": "boolean", "allow_unknown": true, "required": true, "tag_label": "Nickel-free", "true_label": "Nickel-free", "false_label": "Contains nickel", "unknown_label": "Not verified" },
            { "key": "sensitive_skin", "label": "Sensitive-skin compatibility", "type": "select", "options": ["Suitable for sensitive skin", "Not recommended for sensitive skin", "Not tested"] }
          ]
        }
      ],
      "photo_protocol": [
        { "key": "macro_front", "label": "Macro front face", "required": true, "hint": "Fill the frame with the front of one earring." },
        { "key": "backing_closure", "label": "Backing & post closure", "required": true },
        { "key": "side_profile", "label": "Side profile depth", "required": true },
        { "key": "hallmark", "label": "Authenticity / material hallmark stamp", "required": false, "hint": "Skip when the piece carries no stamp." }
      ]
    },
    "rings_bracelets": {
      "version": 1,
      "label": "Rings, Bangles & Bracelets",
      "group": "Jewelry & Small Accessories",
      "profile": "jewelry",
      "summary": "Ring and wrist-jewelry intake: ring size scale, band width and inner diameter in millimetres, wrist fit in centimetres, metal finish and clasp.",
      "core": { "hide": ["size"] },
      "sections": [
        {
          "id": "dimensions", "title": "Dimensions & Units",
          "fields": [
            { "key": "ring_size", "label": "Ring size", "type": "size", "scales": ["US", "EU", "UK"], "presets": { "US": ["4", "4.5", "5", "5.5", "6", "6.5", "7", "7.5", "8", "8.5", "9", "9.5", "10", "11", "12"], "EU": ["46", "48", "50", "52", "54", "56", "58", "60", "62", "64", "66", "68"], "UK": ["H", "I", "J", "K", "L", "M", "N", "O", "P", "Q", "R", "S", "T", "U", "V", "W", "X", "Y", "Z"] }, "required": true, "projects_to": "size", "when": { "subcategory": ["Rings"] } },
            { "key": "band_width", "label": "Band width", "type": "measure", "units": ["mm"], "range": [0.5, 40], "step": 0.1, "when": { "subcategory": ["Rings"] } },
            { "key": "inner_diameter", "label": "Inner diameter", "type": "measure", "units": ["mm"], "range": [30, 120], "step": 0.5, "when": { "subcategory": ["Bracelets", "Bangles", "Cuffs"] } },
            { "key": "wrist_circumference", "label": "Wrist circumference (fits)", "type": "measure", "units": ["cm"], "range": [10, 30], "step": 0.5, "projects_to": "size", "when": { "subcategory": ["Bracelets", "Bangles", "Cuffs"] } }
          ]
        },
        {
          "id": "material", "title": "Material & Metals",
          "fields": [
            { "key": "core_metal", "label": "Core metal composition", "type": "select", "options": ["925 Sterling Silver", "Solid Gold", "Gold Plated", "Gold Filled", "Stainless Steel", "Titanium", "Tungsten", "Brass", "Copper", "Alloy / Mixed Metal"], "allow_other": true, "required": true, "tag": true, "projects_to": "fabric" },
            { "key": "metal_finish", "label": "Metal finish", "type": "select", "options": ["High-Gloss Polish", "Brushed Matte", "Hammered", "Antique Patina", "Sandblasted", "Two-Tone"], "tag": true }
          ]
        },
        {
          "id": "structure", "title": "Structural Attributes",
          "fields": [
            { "key": "adjustability", "label": "Adjustability", "type": "select", "options": ["Fixed diameter", "Adjustable open band", "Stretch / elastic"], "required": true, "tag": true },
            { "key": "clasp_type", "label": "Clasp type", "type": "select", "options": ["Lobster Claw", "Toggle", "Box Latch", "Magnetic", "Spring Ring", "Hinged", "None (slip-on)"], "when": { "subcategory": ["Bracelets", "Bangles", "Cuffs"] } }
          ]
        }
      ],
      "photo_protocol": [
        { "key": "top_face", "label": "Top setting / face view", "required": true },
        { "key": "inner_hallmark", "label": "Inner band hallmark stamp", "required": false, "hint": "Skip when the piece carries no stamp." },
        { "key": "side_profile", "label": "Side band profile", "required": true },
        { "key": "wear_scale", "label": "Wear scale / hand form profile", "required": true }
      ]
    },
    "necklaces": {
      "version": 1,
      "label": "Necklaces & Pendants",
      "group": "Jewelry & Small Accessories",
      "profile": "jewelry",
      "summary": "Necklace intake: chain length in inches or centimetres, pendant and gauge in millimetres, link weave, clasp and extension.",
      "core": { "hide": ["size"] },
      "sections": [
        {
          "id": "dimensions", "title": "Dimensions & Units", "note": "Chain length in inches or centimetres (18 in ≈ 45 cm). Pendant and gauge in millimetres.",
          "fields": [
            { "key": "chain_length", "label": "Chain length", "type": "measure", "units": ["in", "cm"], "range": [6, 40], "step": 0.5, "projects_to": "size" },
            { "key": "pendant_height", "label": "Pendant height", "type": "measure", "units": ["mm"], "range": [2, 150], "step": 0.5, "when": { "subcategory": ["Pendant Necklaces"] } },
            { "key": "pendant_width", "label": "Pendant width", "type": "measure", "units": ["mm"], "range": [2, 150], "step": 0.5, "when": { "subcategory": ["Pendant Necklaces"] } },
            { "key": "chain_gauge", "label": "Chain gauge / thickness", "type": "measure", "units": ["mm"], "range": [0.3, 30], "step": 0.1 }
          ]
        },
        {
          "id": "style", "title": "Style & Weave",
          "fields": [
            { "key": "chain_link_type", "label": "Chain link type", "type": "select", "options": ["Curb", "Rope", "Box", "Snake", "Figaro", "Cuban", "Cable", "Franco", "Herringbone", "Ball / Bead", "Paperclip", "Beaded strand"], "allow_other": true, "required": true, "tag": true },
            { "key": "pendant_design", "label": "Pendant design", "type": "text", "max_length": 80, "placeholder": "Cross, initial, heart locket, Africa map…", "tag": true, "when": { "subcategory": ["Pendant Necklaces"] } },
            { "key": "primary_metal", "label": "Metal / material", "type": "select", "options_ref": "jewelry_metals", "allow_other": true, "required": true, "tag": true, "projects_to": "fabric" }
          ]
        },
        {
          "id": "hardware", "title": "Hardware & Fastenings",
          "fields": [
            { "key": "clasp_type", "label": "Clasp type", "type": "select", "options": ["Lobster Claw", "Spring Ring", "Toggle", "Box Clasp", "Magnetic", "Hook", "Slide / Bolo", "None (continuous)"] },
            { "key": "extension_chain", "label": "Extension chain", "type": "select", "options": ["None", "+1 in extension", "+2 in extension", "+3 in extension"] }
          ]
        }
      ],
      "photo_protocol": [
        { "key": "full_spread", "label": "Full chain spread view", "required": true },
        { "key": "pendant_macro", "label": "Pendant front macro", "required": true, "when": { "subcategory": ["Pendant Necklaces"] } },
        { "key": "clasp_hallmark", "label": "Clasp & hallmark detail", "required": true },
        { "key": "length_scale", "label": "Length scale profile", "required": true, "hint": "Lay the chain beside a tape measure." }
      ]
    },
    "tops": {
      "version": 1,
      "label": "Shirts, Tops & Outerwear",
      "group": "Apparel & Clothing",
      "profile": "apparel",
      "summary": "Garment intake: tagged size, flat-lay chest / length / sleeve / shoulder in inches or centimetres, fabric, fit and hand-feel.",
      "sections": [
        {
          "id": "sizing", "title": "Dimensions & Sizing", "note": "Lay the garment flat, buttoned, without stretching. Optional — fill in any you measured; blanks never block saving.",
          "fields": [
            { "key": "chest", "label": "Chest (pit-to-pit)", "type": "measure", "units": ["in", "cm"], "range": [8, 45], "step": 0.25, "flat_lay_key": "chest" },
            { "key": "length", "label": "Full length (shoulder to hem)", "type": "measure", "units": ["in", "cm"], "range": [10, 70], "step": 0.25, "flat_lay_key": "length" },
            { "key": "sleeve", "label": "Sleeve length", "type": "measure", "units": ["in", "cm"], "range": [1, 40], "step": 0.25, "flat_lay_key": "sleeve" },
            { "key": "shoulder", "label": "Shoulder width", "type": "measure", "units": ["in", "cm"], "range": [8, 30], "step": 0.25, "flat_lay_key": "shoulder" }
          ]
        },
        {
          "id": "fabric", "title": "Fabric & Construction",
          "fields": [
            { "key": "material_composition", "label": "Primary material composition", "type": "select", "options_ref": "apparel_materials", "allow_other": true, "required": true, "tag": true, "projects_to": "fabric" },
            { "key": "knit_weave", "label": "Fabric knit / weave type", "type": "select", "options_ref": "knit_weaves", "allow_other": true, "tag": true }
          ]
        },
        {
          "id": "fit", "title": "Fit & Design Details",
          "fields": [
            { "key": "fit_silhouette", "label": "Fit silhouette", "type": "select", "options": ["Oversized", "Boxy", "Slim Fit", "Regular Fit", "Relaxed", "Cropped", "Tailored"], "tag": true },
            { "key": "neckline", "label": "Neckline", "type": "select", "options_ref": "necklines", "allow_other": true },
            { "key": "closure_type", "label": "Closure type", "type": "select", "options": ["Pullover", "Full-Zip", "Quarter-Zip", "Button Down", "Snap Buttons", "Wrap / Tie", "Open Front"] }
          ]
        },
        {
          "id": "texture", "title": "Texture & Finish",
          "fields": [
            { "key": "hand_feel", "label": "Fabric hand-feel", "type": "select", "options": ["Soft Brushed", "Rigid Denim", "Smooth Woven", "Ribbed", "Waffle", "Silky", "Crisp", "Stretchy"] }
          ]
        }
      ],
      "photo_protocol": [
        { "key": "flat_front", "label": "Flat lay front", "required": true },
        { "key": "flat_back", "label": "Flat lay back", "required": true },
        { "key": "neck_tag", "label": "Inner neck factory tag & sizing stamp", "required": true },
        { "key": "fabric_macro", "label": "Fabric texture macro", "required": true },
        { "key": "stitching", "label": "Stitching / hem detail", "required": false }
      ]
    },
    "bottoms": {
      "version": 1,
      "label": "Pants, Jeans & Skirts",
      "group": "Apparel & Clothing",
      "profile": "apparel",
      "summary": "Bottoms intake: tagged size, flat-lay waist / hip / inseam / rise in inches or centimetres, fabric and fit.",
      "sections": [
        {
          "id": "sizing", "title": "Dimensions & Sizing", "note": "Lay flat, buttoned and zipped. Waist is measured straight across. Optional — fill in any you measured; blanks never block saving.",
          "fields": [
            { "key": "waist", "label": "Waist (flat)", "type": "measure", "units": ["in", "cm"], "range": [8, 40], "step": 0.25, "flat_lay_key": "waist" },
            { "key": "hip", "label": "Hip width", "type": "measure", "units": ["in", "cm"], "range": [8, 45], "step": 0.25, "flat_lay_key": "hip" },
            { "key": "inseam", "label": "Inseam length", "type": "measure", "units": ["in", "cm"], "range": [1, 45], "step": 0.25, "flat_lay_key": "inseam", "when": { "not_subcategory": ["Skirts"] } },
            { "key": "skirt_length", "label": "Skirt length (waist to hem)", "type": "measure", "units": ["in", "cm"], "range": [8, 50], "step": 0.25, "flat_lay_key": "length", "when": { "subcategory": ["Skirts"] } },
            { "key": "rise", "label": "Rise", "type": "measure", "units": ["in", "cm"], "range": [4, 20], "step": 0.25, "flat_lay_key": "rise", "when": { "not_subcategory": ["Skirts"] } },
            { "key": "thigh", "label": "Thigh width", "type": "measure", "units": ["in", "cm"], "range": [4, 25], "step": 0.25, "flat_lay_key": "thigh", "when": { "not_subcategory": ["Skirts"] } },
            { "key": "leg_opening", "label": "Leg opening", "type": "measure", "units": ["in", "cm"], "range": [3, 20], "step": 0.25, "flat_lay_key": "leg_opening", "when": { "not_subcategory": ["Skirts"] } }
          ]
        },
        {
          "id": "fabric", "title": "Fabric & Construction",
          "fields": [
            { "key": "material_composition", "label": "Primary material composition", "type": "select", "options_ref": "apparel_materials", "allow_other": true, "required": true, "tag": true, "projects_to": "fabric" },
            { "key": "knit_weave", "label": "Fabric knit / weave type", "type": "select", "options_ref": "knit_weaves", "allow_other": true, "tag": true }
          ]
        },
        {
          "id": "fit", "title": "Fit & Design Details",
          "fields": [
            { "key": "fit_silhouette", "label": "Fit silhouette", "type": "select", "options": ["Skinny", "Slim", "Straight", "Regular", "Relaxed", "Wide Leg", "Bootcut", "Tapered", "A-Line", "Pencil", "Pleated"], "tag": true },
            { "key": "rise_style", "label": "Rise style", "type": "select", "options": ["Low rise", "Mid rise", "High rise"], "when": { "not_subcategory": ["Skirts"] } },
            { "key": "closure_type", "label": "Closure type", "type": "select", "options": ["Zip Fly", "Button Fly", "Elastic Waist", "Drawstring", "Side Zip", "Back Zip"] }
          ]
        }
      ],
      "photo_protocol": [
        { "key": "flat_front", "label": "Flat lay front", "required": true },
        { "key": "flat_back", "label": "Flat lay back", "required": true },
        { "key": "waist_tag", "label": "Waistband tag & size stamp", "required": true },
        { "key": "fabric_macro", "label": "Fabric texture macro", "required": true },
        { "key": "hem", "label": "Hem / leg-opening detail", "required": false }
      ]
    },
    "dresses": {
      "version": 1,
      "label": "Dresses & One-Pieces",
      "group": "Apparel & Clothing",
      "profile": "apparel",
      "summary": "Dress intake: tagged size, flat-lay bust / waist / hip / length in inches or centimetres, fabric, silhouette and sleeve style.",
      "sections": [
        {
          "id": "sizing", "title": "Dimensions & Sizing", "note": "Lay flat and zipped; bust is measured pit to pit. Optional — fill in any you measured; blanks never block saving.",
          "fields": [
